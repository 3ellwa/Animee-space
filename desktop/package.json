{
  "name": "animee-desktop",
  "productName": "my space",
  "version": "1.0.0",
  "description": "animee, cinemee and mangee in one app, with Discord presence",
  "author": "3ellwa",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "@xhayper/discord-rpc": "^1.5.1",
    "electron-updater": "^6.8.11"
  },
  "build": {
    "appId": "space.animee.myspace",
    "productName": "my space",
    "copyright": "animee space",
    "files": [
      "main.js",
      "preload.js",
      "discord.js",
      "adblock.js",
      "updates.js",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "my-space-setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "my space",
      "uninstallDisplayName": "my space",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "3ellwa",
        "repo": "Animee-space",
        "releaseType": "release"
      }
    ]
  }
}
